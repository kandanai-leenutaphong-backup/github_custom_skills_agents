# Azure OpenAI Configuration
# NEVER commit real values — use managed identity / DefaultAzureCredential in production.

# Required: Your Azure OpenAI resource endpoint
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/

# Required: The deployment name you created in Azure OpenAI Studio
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# Optional: Azure OpenAI API version (default: 2024-02-15-preview)
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Optional: Comma-separated list of allowed CORS origins (default: http://localhost:8080)
ALLOWED_ORIGINS=http://localhost:8080

# ---------------------------------------------------------------------------
# DefaultAzureCredential auth — NO API KEYS NEEDED.
# For local development, run: az login
# For production, assign the "Cognitive Services OpenAI User" role to your
# managed identity or service principal on the Azure OpenAI resource.
# ---------------------------------------------------------------------------
